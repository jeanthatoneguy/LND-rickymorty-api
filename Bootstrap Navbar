<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Base de Datos Temática - Marvel</title>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300;0,700;1,400&display=swap"
        rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="css/marvel-navbar.css">
</head>

<body>
    <nav class="navbar navbar-expand-lg bg-marvel-red navbar-marvel">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">
                <img src="assets/generic-logo.png" alt="Marvel Logo" height="50" />
            </a>

            <button class="navbar-toggler border-dark" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMarvel">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMarvel">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link px-3" href="#">Inicio</a>
                    </li>
                    
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle px-3" href="#" data-bs-toggle="dropdown">
                            Héroes
                        </a>
                        <ul class="dropdown-menu bg-white">
                            <li><a class="dropdown-item text-dark" href="#">Todos los Héroes</a></li>
                            <li><a class="dropdown-item text-dark" href="#">Avengers</a></li>
                            <li><a class="dropdown-item text-dark" href="#">X-Men</a></li>
                            <li><a class="dropdown-item text-dark" href="#">Guardianes de la Galaxia</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-dark" href="#">Favoritos</a></li>
                        </ul>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle px-3" href="#" data-bs-toggle="dropdown">
                            Villanos
                        </a>
                        <ul class="dropdown-menu bg-white">
                            <li><a class="dropdown-item text-dark" href="#">Todos los Villanos</a></li>
                            <li><a class="dropdown-item text-dark" href="#">Principales</a></li>
                            <li><a class="dropdown-item text-dark" href="#">Secundarios</a></li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link px-3" href="#">Cómics</a>
                    </li>
                    
                    <li class="nav-item">
                        <a class="nav-link px-3" href="#">Series</a>
                    </li>
                    
                    <li class="nav-item">
                        <a class="nav-link px-3" href="#">Películas</a>
                    </li>
                </ul>

                <form class="d-flex me-2" role="search">
                    <input class="form-control me-2" type="search" placeholder="Buscar..." />
                    <button class="btn btn-dark" type="submit">Buscar</button>
                </form>

                <button class="btn btn-dark">★</button>
            </div>
        </div>
    </nav>

    <section class="page">
        <aside class="sidebar">
            <h3 class="sidebar__title">🔍 Opciones de Filtrado</h3>

            <div class="sidebar__form form">
                <div class="form__group">
                    <label for="select-filter-one">Filtro Principal:</label>
                    <select id="select-filter-one" name="filter-one">
                        <option value="">-- Selecciona un Contexto --</option>
                    </select>
                </div>
                <div class="form__group">
                    <label for="select-filter-two">Filtro Secundario:</label>
                    <select id="select-filter-two" name="filter-two">
                        <option value="">-- Selecciona una Característica --</option>
                    </select>
                </div>
                <div class="form__group">
                    <label for="select-sort">Ordenar por:</label>
                    <select id="select-sort" name="sort">
                        <option value="name_asc">Nombre (A-Z)</option>
                        <option value="name_desc">Nombre (Z-A)</option>
                        <option value="id_asc">ID/Número (Asc)</option>
                    </select>
                </div>

                <div class="form__group actions">
                    <button id="apply-filters" class="form__button primary">Aplicar Filtros</button>
                    <button id="reset-filters" class="form__button secondary">Limpiar</button>
                </div>
            </div>
        </aside>

        <main id="main">
            <section id="detail-info" class="detail-banner">
                <h2 class="detail-banner__title">Bienvenido a la Base de Datos Marvel</h2>
                <p class="detail-banner__description">
                    Usa los filtros o la barra de búsqueda para explorar los elementos de la colección.
                </p>
                <div class="detail-banner__tag">Tema Actual: <strong id="current-theme">Marvel Universe</strong></div>
            </section>

            <section class="list__section">
                <h3 class="list__heading">Resultados Encontrados (<span id="results-count">0</span>)</h3>

                <ul id="item-list" class="list list__items">
                    <li class="list__item item item-card" data-id="213">
                        <div class="item-card__header">
                            <img src="./assets/placeholder.svg" alt="Imagen del elemento" class="item-card__image" />
                            <button class="item-card__fav-toggle" aria-label="Añadir a favoritos">★</button>
                        </div>
                        <h2 class="item-card__name">Nombre del Elemento</h2>
                        <div class="item-card__info-grid">
                            <div class="item-card__data"><strong>Campo 1:</strong> <span class="data-value"
                                    id="data-1">Valor</span></div>
                            <div class="item-card__data"><strong>Campo 2:</strong> <span class="data-value"
                                    id="data-2">Valor</span></div>
                            <div class="item-card__data"><strong>Campo 3:</strong> <span class="data-value"
                                    id="data-3">Valor</span></div>
                            <div class="item-card__data"><strong>Campo 4:</strong> <span class="data-value"
                                    id="data-4">Valor</span></div>
                        </div>
                        <button class="item-card__view-details">Ver Detalles</button>
                        <div class="item-card__actions">
                            <button class="btn-details">Ampliar detalles</button>
                            <button class="btn-gallery">Ver galería</button>
                            <button class="btn-stories">Más historias</button>
                        </div>
                    </li>
                </ul>

                <div class="list__status-controls">
                    <div id="loading-message" style="display: none;">⏳ Cargando elementos...</div>
                    <div id="pagination-controls" class="pagination-controls" style="display: none;">
                        <button id="prev-page" class="control__button" disabled>Anterior</button>
                        <span id="current-page">Página 1</span>
                        <button id="next-page" class="control__button">Siguiente</button>
                    </div>
                </div>
            </section>
        </main>

        <footer class="footer">
            <p class="footer__logo"> <img src="pic_trulli.jpg"> LOGO WEB </p>
            <p class="footer__text">&copy; 2025 Base de Datos Temática. Desarrollado para tu proyecto.</p>
            <div class="iconos__redes">
                <button id="instagram" class="form__button secondary"><img src="pic_trulli.jpg"></button>
                <button id="twitter" class="form__button secondary"><img src="pic_trulli.jpg"></button>
                <button id="email" class="form__button secondary"><img src="pic_trulli.jpg"></button>
            </div>
            <div class="politicas__web">
                <a href="https://www.aepd.es/politica-de-privacidad-y-aviso-legal">Legal</a>
                <a href="https://www.aepd.es/politica-de-privacidad-y-aviso-legal">Privacy</a>
                <a href="https://www.interior.gob.es/opencms/es/politica-de-cookies/">Cookies</a>
            </div>
            <p class="footer__support__titulo"> <strong> SUPPORT</strong> </p>
            <div class="footer__support__enlaces">
                <a href="https://www.aepd.es/politica-de-privacidad-y-aviso-legal">Help Center</a>
                <a href="https://www.aepd.es/politica-de-privacidad-y-aviso-legal">Contact Us</a>
                <a href="https://www.aepd.es/politica-de-privacidad-y-aviso-legal">Privacy Policy</a>
                <a href="https://www.aepd.es/politica-de-privacidad-y-aviso-legal">Terms of Use</a>
            </div>
        </footer>
    </section>

    <div id="item-modal" class="modal" style="display:none;">
        <div class="modal-content">
            <span class="modal-close-button">&times;</span>
            <div id="modal-body"></div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
</body>

</html>
